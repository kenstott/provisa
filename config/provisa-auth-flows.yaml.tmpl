# The auth-flows Playwright project's instance (scripts/launch-demo-regions.sh --test --auth-flows):
# one node, no regions, basic auth ENFORCED. The membership flows those specs walk — leaving an org
# (REQ-1306), auto-join on sign-in (REQ-1285), a backup platform_admin made by invite (REQ-1298) —
# only exist for a real signed-in identity, which the core Playwright backend (auth.provider: none)
# never has. Nothing but the break-glass superuser is configured: each spec creates the users and
# orgs it needs through the authenticated admin API. @@JWT_SECRET@@ and @@BOOTSTRAP@@ are the
# launcher's.

federation_engine: duckdb

# Orgs, membership and auto-join (REQ-1285/1568) are the multitenant plane; single-tenant has one
# org and the sign-in auto-join never runs.
multitenancy: true

auth:
  provider: basic
  # /auth/register: users join by redeeming an invite, or (for the auto-join flow) sign up and are
  # admitted by an org's email rule.
  allow_simple_auth: true
  jwt_secret: "@@JWT_SECRET@@"
  # REQ-125: the break-glass superuser (/auth/superuser-login), control-plane only.
  superuser:
    username: ${env:PROVISA_SUPERUSER_USERNAME}
    password: ${env:PROVISA_SUPERUSER_PASSWORD}
  assignments_source: provisa
  # REQ-1290: true only for the spec that needs a platform_admin (launcher --bootstrap); it claims
  # the slot itself. Elsewhere an open slot would put the first-login disclosure in every sign-in.
  bootstrap_superadmin: @@BOOTSTRAP@@

cache:
  enabled: false

domains:
  - { id: flows, description: "Auth flows" }

# The seeded roles (org_admin, analyst, ...) are the ones the flows use; none is declared here.
roles: []

sources: []
tables: []
relationships: []
rls_rules: []
functions: []
webhooks: []
