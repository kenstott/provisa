# Transient Trino catalog artifacts (rebuild triggers, temp/probe catalogs; may hold creds)
/trino/catalog-install/rebuild_trigger.properties
/trino/catalog-install/tmp_src_*.properties
/trino/catalog-install/e2e_*.properties
/trino/catalog-install/test_*.properties
# EVERY file in /trino/catalog is written by Trino's FileCatalogStore when Provisa issues
# CREATE CATALOG (catalog.management=dynamic) — none of them is authored. Committing them shipped a
# dev-box artifact whose connection-url named the dev compose network (postgres:5432, mongodb:27017,
# kafka:29092). catalog.create_catalog skips a catalog that already exists, so on a deployment whose
# data plane is elsewhere the stale file WON: cloud.provisa.dev pointed inquiries_sqlite/petstore_api
# at a Postgres holding no landed demo data and every query died with
# SCHEMA_NOT_FOUND "Schema 'default' does not exist".
/trino/catalog/*.properties
sharepoint.pfx
Volumes/
coverage.xml
*.bak

# isolated mv-mvp test env (local only; DSNs are hardcoded in tests)
.env.mvmvp

# Office temp/lock files
~$*

# Built UI assets staged for the Docker image (vite build output, COPY'd in Dockerfile).
# Generated by `vite build` + copied from provisa-ui/dist — not source. Keep the dir marker.
/static/*
!/static/.gitkeep

# Wheel build staging (scripts/build-wheel.sh) — REQ-1127
provisa/_ui/
provisa/_config/

# provisa-duckdb-ext blobs are built per-platform by CI (build-duckdb-extensions), not committed.
packaging/duckdb-ext/provisa_duckdb_ext/_ext/**
!packaging/duckdb-ext/provisa_duckdb_ext/_ext/.gitkeep

# MkDocs build output (generated homepage + build dir)
docs/index.md
docs/*/index.md
docs_site/
# Auto-generated site assets: MkDocs build output + wrangler cache (never commit)
site/docs/
site/.wrangler/
.test-all-run.log

# Terraform plan binaries embed resolved variable values, including the Cloud SQL password.
*.tfplan
