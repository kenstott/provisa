new file mode 100644
index 0000000..2c1f3d1
--- /dev/null
+++ b/src/main/java/ru/raiffeisen/trino/arrow/flight/sql/producer/TrinoStatementExecution.java
@@ -0,0 +1,170 @@
+package ru.raiffeisen.trino.arrow.flight.sql.producer;
+
+import io.trino.client.Column;
+import io.trino.client.QueryError;
+import io.trino.client.QueryStatusInfo;
+import io.trino.client.StatementClient;
+import org.apache.arrow.flight.BackpressureStrategy;
+import org.apache.arrow.flight.FlightProducer;
+import org.apache.arrow.memory.BufferAllocator;
+import org.apache.arrow.vector.FieldVector;
+import org.apache.arrow.vector.VectorSchemaRoot;
+import org.apache.arrow.vector.types.pojo.Schema;
+import org.apache.commons.lang3.tuple.ImmutablePair;
+import org.slf4j.Logger;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.slf4j.LoggerFactory.getLogger;
+
+/**
+ * One statement running on Trino through the client protocol, from the moment its result columns
+ * are known to the last row streamed.
+ *
+ * <p>{@link #start} runs at GetFlightInfo: the statement is submitted and followed until Trino
+ * names its columns, so the schema the FlightInfo announces is the one the stream carries, and a
+ * statement Trino rejects is answered there with Trino's error. {@link #stream} runs at DoGet and
+ * writes the rows as Arrow batches.
+ */
+final class TrinoStatementExecution implements AutoCloseable {
+  private static final Logger log = getLogger(TrinoStatementExecution.class);
+
+  private final StatementClient client;
+  private final List<TrinoArrowColumn> columns;
+  private final Schema schema;
+
+  private TrinoStatementExecution(StatementClient client, List<Column> trinoColumns) {
+    this.client = client;
+    List<TrinoArrowColumn> arrowColumns = new ArrayList<>(trinoColumns.size());
+    for (Column column : trinoColumns) {
+      arrowColumns.add(TrinoArrowColumn.of(column));
+    }
+    this.columns = arrowColumns;
+    this.schema = new Schema(arrowColumns.stream().map(TrinoArrowColumn::field).toList());
+  }
+
+  /**
+   * Follows {@code client} until Trino names the statement's columns (or the statement ends).
+   * The client is closed, and the statement cancelled, when this throws.
+   */
+  static TrinoStatementExecution start(StatementClient client) throws TrinoQueryFailure {
+    try {
+      while (client.isRunning() && client.currentStatusInfo().getColumns() == null) {
+        client.advance();
+      }
+      List<Column> trinoColumns;
+      if (client.isRunning()) {
+        trinoColumns = client.currentStatusInfo().getColumns();
+      } else {
+        QueryStatusInfo finalStatus = client.finalStatusInfo();
+        failIfFailed(finalStatus);
+        trinoColumns = finalStatus.getColumns() == null ? List.of() : finalStatus.getColumns();
+      }
+      return new TrinoStatementExecution(client, trinoColumns);
+    } catch (TrinoQueryFailure failure) {
+      client.close();
+      throw failure;
+    } catch (RuntimeException e) {
+      client.close();
+      throw TrinoQueryFailure.unreachable(e);
+    }
+  }
+
+  Schema schema() {
+    return schema;
+  }
+
+  /**
+   * Streams the statement's rows to {@code listener} in batches of at most {@code batchSize}
+   * rows. Returns the rows streamed and the milliseconds spent streaming them. A statement that
+   * fails while its rows are read throws its Trino error; a listener the client cancelled ends
+   * the stream and cancels the statement.
+   */
+  ImmutablePair<Integer, Long> stream(
+      BufferAllocator allocator,
+      FlightProducer.ServerStreamListener listener,
+      int batchSize,
+      long waitTimeout)
+      throws TrinoQueryFailure {
+    BackpressureStrategyImpl backpressure = new BackpressureStrategyImpl();
+    backpressure.register(listener);
+    long started = System.currentTimeMillis();
+    int streamed = 0;
+    try (VectorSchemaRoot root = VectorSchemaRoot.create(schema, allocator)) {
+      listener.start(root);
+      root.allocateNew();
+      int pending = 0;
+      while (client.isRunning()) {
+        Iterable<List<Object>> data = client.currentData().getData();
+        if (data != null) {
+          for (List<Object> row : data) {
+            for (int i = 0; i < columns.size(); i++) {
+              FieldVector vector = root.getVector(i);
+              columns.get(i).write(vector, pending, row.get(i));
+            }
+            pending++;
+            if (pending == batchSize) {
+              if (!send(root, pending, listener, backpressure, waitTimeout)) {
+                return new ImmutablePair<>(streamed, System.currentTimeMillis() - started);
+              }
+              streamed += pending;
+              pending = 0;
+            }
+          }
+        }
+        client.advance();
+      }
+      failIfFailed(client.finalStatusInfo());
+      if (pending > 0) {
+        if (!send(root, pending, listener, backpressure, waitTimeout)) {
+          return new ImmutablePair<>(streamed, System.currentTimeMillis() - started);
+        }
+        streamed += pending;
+      }
+    } catch (TrinoQueryFailure failure) {
+      throw failure;
+    } catch (RuntimeException e) {
+      if (client.isClientAborted() || listener.isCancelled()) {
+        log.warn("Stream ended by cancellation: {}", e.getMessage());
+        return new ImmutablePair<>(streamed, System.currentTimeMillis() - started);
+      }
+      throw TrinoQueryFailure.unreachable(e);
+    }
+    return new ImmutablePair<>(streamed, System.currentTimeMillis() - started);
+  }
+
+  /** Sends the {@code rows} rows held in {@code root}; false when the client stopped listening
+   * (the statement is then cancelled). */
+  private boolean send(
+      VectorSchemaRoot root,
+      int rows,
+      FlightProducer.ServerStreamListener listener,
+      BackpressureStrategyImpl backpressure,
+      long waitTimeout) {
+    BackpressureStrategy.WaitResult ready = backpressure.waitForListener(waitTimeout);
+    if (ready != BackpressureStrategy.WaitResult.READY) {
+      log.warn("Listener not ready ({}): the statement is cancelled.", ready);
+      client.close();
+      return false;
+    }
+    root.setRowCount(rows);
+    listener.putNext();
+    root.clear();
+    root.allocateNew();
+    return true;
+  }
+
+  private static void failIfFailed(QueryStatusInfo status) throws TrinoQueryFailure {
+    QueryError error = status.getError();
+    if (error != null) {
+      throw TrinoQueryFailure.of(status.getId(), error);
+    }
+  }
+
+  /** Cancels the statement if it is still running. */
+  @Override
+  public void close() {
+    client.close();
+  }
+}
