diff --git a/src/main/java/ru/raiffeisen/trino/arrow/flight/sql/server/TrinoContextMiddleware.java b/src/main/java/ru/raiffeisen/trino/arrow/flight/sql/server/TrinoContextMiddleware.java
new file mode 100644
index 0000000..f182875
--- /dev/null
+++ b/src/main/java/ru/raiffeisen/trino/arrow/flight/sql/server/TrinoContextMiddleware.java
@@ -0,0 +1,51 @@
+package ru.raiffeisen.trino.arrow.flight.sql.server;
+
+import org.apache.arrow.flight.CallHeaders;
+import org.apache.arrow.flight.CallInfo;
+import org.apache.arrow.flight.CallStatus;
+import org.apache.arrow.flight.FlightProducer;
+import org.apache.arrow.flight.FlightServerMiddleware;
+import org.apache.arrow.flight.RequestContext;
+import ru.raiffeisen.trino.arrow.flight.sql.connection.TrinoStatementContext;
+
+/** Reads a call's {@value TrinoStatementContext#HEADER} header into its statement's context. */
+public final class TrinoContextMiddleware implements FlightServerMiddleware {
+  public static final Key<TrinoContextMiddleware> KEY = Key.of("trino-context");
+
+  private final TrinoStatementContext context;
+
+  private TrinoContextMiddleware(TrinoStatementContext context) {
+    this.context = context;
+  }
+
+  /** The context of the call {@code callContext}. */
+  public static TrinoStatementContext of(FlightProducer.CallContext callContext) {
+    TrinoContextMiddleware middleware = callContext.getMiddleware(KEY);
+    if (middleware == null) {
+      throw new IllegalStateException("TrinoContextMiddleware is not registered on the server");
+    }
+    return middleware.context;
+  }
+
+  public static final class Factory implements FlightServerMiddleware.Factory<TrinoContextMiddleware> {
+    @Override
+    public TrinoContextMiddleware onCallStarted(
+        CallInfo info, CallHeaders incomingHeaders, RequestContext context) {
+      try {
+        return new TrinoContextMiddleware(
+            TrinoStatementContext.parse(incomingHeaders.get(TrinoStatementContext.HEADER)));
+      } catch (IllegalArgumentException e) {
+        throw CallStatus.INVALID_ARGUMENT.withDescription(e.getMessage()).toRuntimeException();
+      }
+    }
+  }
+
+  @Override
+  public void onBeforeSendingHeaders(CallHeaders outgoingHeaders) {}
+
+  @Override
+  public void onCallCompleted(CallStatus status) {}
+
+  @Override
+  public void onCallErrored(Throwable err) {}
+}
