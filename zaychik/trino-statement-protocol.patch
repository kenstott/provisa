+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+/** Gap 3: a statement's session reaches Trino from the Flight call header. */
+class TrinoStatementContextTest {
+
+  private static String header(String json) {
+    return Base64.getEncoder().encodeToString(json.getBytes(StandardCharsets.UTF_8));
+  }
+
+  @Test
+  void parsesSourceCatalogSchemaAndSessionProperties() {
+    TrinoStatementContext context =
+        TrinoStatementContext.parse(
+            header(
+                "{\"source\":\"provisa/org-1\",\"catalog\":\"system\",\"schema\":\"org_1\","
+                    + "\"properties\":{\"query_max_execution_time\":\"120s\",\"retry_policy\":\"TASK\"}}"));
+    assertEquals(Optional.of("provisa/org-1"), context.source());
+    assertEquals(Optional.of("system"), context.catalog());
+    assertEquals(Optional.of("org_1"), context.schema());
+    assertEquals(
+        Map.of("query_max_execution_time", "120s", "retry_policy", "TASK"), context.properties());
+  }
+
+  @Test
+  void absentHeaderIsNoContext() {
+    assertEquals(TrinoStatementContext.NONE, TrinoStatementContext.parse(null));
+  }
+
+  @Test
+  void malformedHeaderIsRefused() {
+    assertThrows(IllegalArgumentException.class, () -> TrinoStatementContext.parse("not base64!"));
+    assertThrows(
+        IllegalArgumentException.class,
+        () -> TrinoStatementContext.parse(header("{\"properties\":{\"a\":1}}")));
+  }
+}
diff --git a/src/test/java/ru/raiffeisen/trino/arrow/flight/sql/producer/TrinoArrowColumnTest.java b/src/test/java/ru/raiffeisen/trino/arrow/flight/sql/producer/TrinoArrowColumnTest.java
new file mode 100644
index 0000000..4c79d92
--- /dev/null
+++ b/src/test/java/ru/raiffeisen/trino/arrow/flight/sql/producer/TrinoArrowColumnTest.java
@@ -0,0 +1,217 @@
+package ru.raiffeisen.trino.arrow.flight.sql.producer;
+
+import io.trino.client.ClientTypeSignature;
+import io.trino.client.ClientTypeSignatureParameter;
+import io.trino.client.Column;
+import io.trino.client.NamedClientTypeSignature;
+import io.trino.client.Row;
+import io.trino.client.RowFieldName;
+import org.apache.arrow.memory.BufferAllocator;
+import org.apache.arrow.memory.RootAllocator;
+import org.apache.arrow.vector.FieldVector;
+import org.apache.arrow.vector.TimeStampMicroVector;
+import org.apache.arrow.vector.VarCharVector;
+import org.apache.arrow.vector.types.TimeUnit;
+import org.apache.arrow.vector.types.pojo.ArrowType;
+import org.apache.arrow.vector.types.pojo.Field;
+import org.junit.jupiter.api.Test;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Expected values are what the Trino Python client (trino.mapper) gives for the same protocol
+ * text, in microseconds since the epoch / midnight: the two readers must agree.
+ */
+class TrinoArrowColumnTest {
+
+  private static ClientTypeSignature type(String raw, ClientTypeSignatureParameter... args) {
+    return new ClientTypeSignature(raw, Arrays.asList(args));
+  }
+
+  private static ClientTypeSignatureParameter precision(long p) {
+    return ClientTypeSignatureParameter.ofLong(p);
+  }
+
+  // -- gap 1: microsecond temporal values, rounded as the Python client rounds ------------------
+
+  @Test
+  void timestampKeepsMicroseconds() {
+    assertEquals(1704164645123456L, TrinoArrowColumn.timestampMicros("2024-01-02 03:04:05.123456"));
+  }
+
+  @Test
+  void timestampBeyondMicrosRoundsHalfEven() {
+    assertEquals(
+        1704164645123456L, TrinoArrowColumn.timestampMicros("2024-01-02 03:04:05.123456500"));
+    assertEquals(
+        1704164645123458L, TrinoArrowColumn.timestampMicros("2024-01-02 03:04:05.123457500"));
+  }
+
+  @Test
+  void timestampRoundingCarriesIntoTheNextSecond() {
+    assertEquals(
+        1735689600000000L, TrinoArrowColumn.timestampMicros("2024-12-31 23:59:59.999999999"));
+  }
+
+  @Test
+  void timestampWithoutFractionAndBeforeTheEpoch() {
+    assertEquals(-1000000L, TrinoArrowColumn.timestampMicros("1969-12-31 23:59:59"));
+  }
+
+  @Test
+  void timeWrapsAtMidnightWhenRoundedUp() {
+    assertEquals(0L, TrinoArrowColumn.timeMicros("23:59:59.9999999"));
+  }
+
+  @Test
+  void timeOfPicosecondPrecision() {
+    assertEquals(3723123457L, TrinoArrowColumn.timeMicros("01:02:03.123456789012"));
+  }
+
+  @Test
+  void zonedTimestampInARegion() {
+    assertEquals(
+        1710052200123000L,
+        TrinoArrowColumn.zonedTimestampMicros("2024-03-10 01:30:00.123 America/New_York"));
+  }
+
+  @Test
+  void zonedTimestampInTheRepeatedHourIsTheEarlierInstant() {
+    assertEquals(
+        1730611800000001L,
+        TrinoArrowColumn.zonedTimestampMicros("2024-11-03 01:30:00.000001 America/New_York"));
+  }
+
+  @Test
+  void zonedTimestampAtAnOffset() {
+    assertEquals(
+        1704144845000006L, TrinoArrowColumn.zonedTimestampMicros("2024-01-02 03:04:05.000006 +05:30"));
+  }
+
+  @Test
+  void dateIsProlepticGregorian() {
+    assertEquals(-354285, TrinoArrowColumn.dateDays("1000-01-01"));
+    assertEquals(-141432, TrinoArrowColumn.dateDays("1582-10-10"));
+  }
+
+  @Test
+  void temporalFieldsAreMicrosecond() {
+    Field ts = TrinoArrowColumn.of(new Column("t", "timestamp(6)", type("timestamp", precision(6)))).field();
+    assertEquals(new ArrowType.Timestamp(TimeUnit.MICROSECOND, null), ts.getType());
+    Field tz =
+        TrinoArrowColumn.of(
+                new Column(
+                    "z",
+                    "timestamp(3) with time zone",
+                    type("timestamp with time zone", precision(3))))
+            .field();
+    assertEquals(new ArrowType.Timestamp(TimeUnit.MICROSECOND, "UTC"), tz.getType());
+    Field time = TrinoArrowColumn.of(new Column("c", "time(6)", type("time", precision(6)))).field();
+    assertEquals(new ArrowType.Time(TimeUnit.MICROSECOND, 64), time.getType());
+  }
+
+  @Test
+  void timestampVectorHoldsTheRoundedValue() {
+    TrinoArrowColumn column =
+        TrinoArrowColumn.of(new Column("t", "timestamp(9)", type("timestamp", precision(9))));
+    try (BufferAllocator allocator = new RootAllocator();
+        FieldVector vector = column.field().createVector(allocator)) {
+      vector.allocateNew();
+      column.write(vector, 0, "2024-01-02 03:04:05.123456500");
+      column.write(vector, 1, null);
+      vector.setValueCount(2);
+      assertEquals(1704164645123456L, ((TimeStampMicroVector) vector).get(0));
+      assertTrue(vector.isNull(1));
+    }
+  }
+
+  // -- gaps 2 and 4: types without an Arrow type, and every column's Trino type ----------------
+
+  @Test
+  void everyFieldNamesItsTrinoType() {
+    Field field =
+        TrinoArrowColumn.of(new Column("n", "decimal(10,2)", type("decimal", precision(10), precision(2))))
+            .field();
+    assertEquals(new ArrowType.Decimal(10, 2, 128), field.getType());
+    assertEquals("decimal(10,2)", field.getMetadata().get(TrinoArrowColumn.TYPE_KEY));
+    assertEquals("arrow", field.getMetadata().get(TrinoArrowColumn.ENCODING_KEY));
+    assertEquals(
+        "{\"rawType\":\"decimal\",\"arguments\":[{\"kind\":\"LONG\",\"value\":10},{\"kind\":\"LONG\",\"value\":2}]}",
+        field.getMetadata().get(TrinoArrowColumn.SIGNATURE_KEY));
+  }
+
+  @Test
+  void scalarWithoutArrowTypeIsItsText() {
+    for (String raw :
+        List.of(
+            "uuid",
+            "ipaddress",
+            "json",
+            "interval day to second",
+            "interval year to month",
+            "time with time zone")) {
+      Field field = TrinoArrowColumn.of(new Column("c", raw, type(raw))).field();
+      assertEquals(ArrowType.Utf8.INSTANCE, field.getType(), raw);
+      assertEquals("text", field.getMetadata().get(TrinoArrowColumn.ENCODING_KEY), raw);
+      assertEquals(raw, field.getMetadata().get(TrinoArrowColumn.TYPE_KEY), raw);
+    }
+  }
+
+  @Test
+  void structuralTypeIsItsProtocolJson() {
+    ClientTypeSignature row =
+        type(
+            "row",
+            ClientTypeSignatureParameter.ofNamedType(
+                new NamedClientTypeSignature(
+                    Optional.of(new RowFieldName("a")), type("bigint"))),
+            ClientTypeSignatureParameter.ofNamedType(
+                new NamedClientTypeSignature(Optional.empty(), type("varbinary"))));
+    TrinoArrowColumn column = TrinoArrowColumn.of(new Column("r", "row(a bigint, varbinary)", row));
+    Field field = column.field();
+    assertEquals(ArrowType.Utf8.INSTANCE, field.getType());
+    assertEquals("json", field.getMetadata().get(TrinoArrowColumn.ENCODING_KEY));
+    // An unnamed field has no fieldName key, as the coordinator writes it.
+    assertEquals(
+        "{\"rawType\":\"row\",\"arguments\":[{\"kind\":\"NAMED_TYPE\",\"value\":{\"fieldName\":{\"name\":\"a\"},"
+            + "\"typeSignature\":{\"rawType\":\"bigint\",\"arguments\":[]}}},{\"kind\":\"NAMED_TYPE\",\"value\":"
+            + "{\"typeSignature\":{\"rawType\":\"varbinary\",\"arguments\":[]}}}]}",
+        field.getMetadata().get(TrinoArrowColumn.SIGNATURE_KEY));
+    try (BufferAllocator allocator = new RootAllocator();
+        FieldVector vector = field.createVector(allocator)) {
+      vector.allocateNew();
+      column.write(
+          vector,
+          0,
+          Row.builder().addField("a", 7L).addUnnamedField(new byte[] {1, 2, 3}).build());
+      vector.setValueCount(1);
+      assertEquals(
+          "[7,\"AQID\"]",
+          new String(((VarCharVector) vector).get(0), StandardCharsets.UTF_8));
+    }
+  }
+
+  @Test
+  void protocolJsonWritesNonFiniteNumbersAsTheProtocolDoes() {
+    Map<Object, Object> map = new LinkedHashMap<>();
+    map.put(1L, Arrays.asList(Double.NaN, Double.POSITIVE_INFINITY, 0.1, null));
+    map.put(2L, List.of(Float.NEGATIVE_INFINITY, 0.1f));
+    assertEquals(
+        "{\"1\":[\"NaN\",\"Infinity\",0.1,null],\"2\":[\"-Infinity\",0.1]}",
+        TrinoArrowColumn.protocolJson(map));
+  }
+
+  @Test
+  void bareNullIsNullType() {
+    Field field = TrinoArrowColumn.of(new Column("x", "unknown", type("unknown"))).field();
+    assertEquals(ArrowType.Null.INSTANCE, field.getType());
+  }
+}
diff --git a/src/test/java/ru/raiffeisen/trino/arrow/flight/sql/producer/TrinoQueryFailureTest.java b/src/test/java/ru/raiffeisen/trino/arrow/flight/sql/producer/TrinoQueryFailureTest.java
new file mode 100644
index 0000000..cc8c9ef
--- /dev/null
+++ b/src/test/java/ru/raiffeisen/trino/arrow/flight/sql/producer/TrinoQueryFailureTest.java
@@ -0,0 +1,62 @@
+package ru.raiffeisen.trino.arrow.flight.sql.producer;
+
+import io.trino.client.QueryError;
+import org.apache.arrow.flight.FlightRuntimeException;
+import org.apache.arrow.flight.FlightStatusCode;
+import org.junit.jupiter.api.Test;
+
+import java.io.UncheckedIOException;
+import java.nio.charset.StandardCharsets;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+
+/** Gap 5: Trino's error reaches the Flight client by name, not as a bare INTERNAL. */
+class TrinoQueryFailureTest {
+
+  @Test
+  void userErrorCarriesTrinosNameTypeCodeAndQueryId() {
+    QueryError error =
+        new QueryError(
+            "line 1:15: Catalog 'nope' not found", null, 44, "CATALOG_NOT_FOUND", "USER_ERROR", null, null);
+    FlightRuntimeException flight = TrinoQueryFailure.of("20261102_000001_00001_abcde", error).toFlightError();
+    assertEquals(FlightStatusCode.INVALID_ARGUMENT, flight.status().code());
+    assertEquals("line 1:15: Catalog 'nope' not found", flight.status().description());
+    assertEquals("CATALOG_NOT_FOUND", flight.status().metadata().get(TrinoQueryFailure.ERROR_NAME));
+    assertEquals("USER_ERROR", flight.status().metadata().get(TrinoQueryFailure.ERROR_TYPE));
+    assertEquals("44", flight.status().metadata().get(TrinoQueryFailure.ERROR_CODE));
+    assertEquals(
+        "20261102_000001_00001_abcde", flight.status().metadata().get(TrinoQueryFailure.QUERY_ID));
+    assertEquals("query", flight.status().metadata().get(TrinoQueryFailure.ERROR_KIND));
+    assertArrayEquals(
+        "line 1:15: Catalog 'nope' not found".getBytes(StandardCharsets.UTF_8),
+        flight.status().metadata().getByte(TrinoQueryFailure.ERROR_MESSAGE));
+  }
+
+  @Test
+  void resourceErrorIsResourceExhausted() {
+    QueryError error =
+        new QueryError(
+            "Query exceeded per-node memory limit",
+            null,
+            131079,
+            "EXCEEDED_LOCAL_MEMORY_LIMIT",
+            "INSUFFICIENT_RESOURCES",
+            null,
+            null);
+    assertEquals(
+        FlightStatusCode.RESOURCE_EXHAUSTED,
+        TrinoQueryFailure.of("q", error).toFlightError().status().code());
+  }
+
+  @Test
+  void unreachableCoordinatorIsUnavailableWithNoErrorName() {
+    FlightRuntimeException flight =
+        TrinoQueryFailure.unreachable(new UncheckedIOException(new java.io.IOException("Connection refused")))
+            .toFlightError();
+    assertEquals(FlightStatusCode.UNAVAILABLE, flight.status().code());
+    assertEquals("connection", flight.status().metadata().get(TrinoQueryFailure.ERROR_KIND));
+    assertFalse(flight.status().metadata().containsKey(TrinoQueryFailure.ERROR_NAME));
+  }
+}
