@@ -0,0 +1,82 @@
+package ru.raiffeisen.trino.arrow.flight.sql.connection;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.Base64;
+import java.util.Iterator;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Optional;
+
+/**
+ * The Trino session a Flight client asks its statement to run in, sent in the call header
+ * {@value #HEADER}: base64 of a JSON object
+ *
+ * <pre>{"source": "...", "catalog": "...", "schema": "...", "properties": {"name": "value"}}</pre>
+ *
+ * <p>Every key is optional. {@code properties} are Trino session properties, sent with the
+ * statement as the Trino client protocol sends them ({@code X-Trino-Session}); a connection that
+ * opens per statement cannot carry a {@code SET SESSION} from one statement to the next, so this is
+ * how a statement gets them.
+ */
+public record TrinoStatementContext(
+    Optional<String> source,
+    Optional<String> catalog,
+    Optional<String> schema,
+    Map<String, String> properties) {
+
+  public static final String HEADER = "x-provisa-trino-context";
+
+  public static final TrinoStatementContext NONE =
+      new TrinoStatementContext(Optional.empty(), Optional.empty(), Optional.empty(), Map.of());
+
+  private static final ObjectMapper MAPPER = new ObjectMapper();
+
+  /** The context {@code header} (the header's value) names; {@link #NONE} when it is absent. */
+  public static TrinoStatementContext parse(String header) {
+    if (header == null) {
+      return NONE;
+    }
+    JsonNode root;
+    try {
+      root = MAPPER.readTree(new String(Base64.getDecoder().decode(header), StandardCharsets.UTF_8));
+    } catch (IOException | IllegalArgumentException e) {
+      throw new IllegalArgumentException(HEADER + " is not base64 of a JSON object: " + e.getMessage(), e);
+    }
+    if (!root.isObject()) {
+      throw new IllegalArgumentException(HEADER + " is not a JSON object");
+    }
+    Map<String, String> properties = new LinkedHashMap<>();
+    JsonNode props = root.path("properties");
+    if (!props.isMissingNode()) {
+      if (!props.isObject()) {
+        throw new IllegalArgumentException(HEADER + ": properties is not a JSON object");
+      }
+      Iterator<Map.Entry<String, JsonNode>> fields = props.fields();
+      while (fields.hasNext()) {
+        Map.Entry<String, JsonNode> field = fields.next();
+        if (!field.getValue().isTextual()) {
+          throw new IllegalArgumentException(
+              HEADER + ": session property " + field.getKey() + " is not a string");
+        }
+        properties.put(field.getKey(), field.getValue().textValue());
+      }
+    }
+    return new TrinoStatementContext(
+        text(root, "source"), text(root, "catalog"), text(root, "schema"), Map.copyOf(properties));
+  }
+
+  private static Optional<String> text(JsonNode root, String key) {
+    JsonNode node = root.path(key);
+    if (node.isMissingNode() || node.isNull()) {
+      return Optional.empty();
+    }
+    if (!node.isTextual()) {
+      throw new IllegalArgumentException(HEADER + ": " + key + " is not a string");
+    }
+    return Optional.of(node.textValue());
+  }
+}
