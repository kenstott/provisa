+++ b/src/main/java/ru/raiffeisen/trino/arrow/flight/sql/producer/TrinoArrowColumn.java
@@ -0,0 +1,375 @@
+package ru.raiffeisen.trino.arrow.flight.sql.producer;
+
+import com.fasterxml.jackson.annotation.JsonInclude;
+import com.fasterxml.jackson.core.JsonFactory;
+import com.fasterxml.jackson.core.JsonGenerator;
+import com.fasterxml.jackson.core.JsonProcessingException;
+import com.fasterxml.jackson.databind.MapperFeature;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.fasterxml.jackson.databind.json.JsonMapper;
+import com.fasterxml.jackson.datatype.jdk8.Jdk8Module;
+import io.trino.client.ClientTypeSignature;
+import io.trino.client.ClientTypeSignatureParameter;
+import io.trino.client.Column;
+import io.trino.client.Row;
+import io.trino.client.RowField;
+import org.apache.arrow.vector.BaseFixedWidthVector;
+import org.apache.arrow.vector.BaseVariableWidthVector;
+import org.apache.arrow.vector.BigIntVector;
+import org.apache.arrow.vector.BitVector;
+import org.apache.arrow.vector.DateDayVector;
+import org.apache.arrow.vector.DecimalVector;
+import org.apache.arrow.vector.FieldVector;
+import org.apache.arrow.vector.Float4Vector;
+import org.apache.arrow.vector.Float8Vector;
+import org.apache.arrow.vector.IntVector;
+import org.apache.arrow.vector.SmallIntVector;
+import org.apache.arrow.vector.TimeMicroVector;
+import org.apache.arrow.vector.TimeStampMicroTZVector;
+import org.apache.arrow.vector.TimeStampMicroVector;
+import org.apache.arrow.vector.TinyIntVector;
+import org.apache.arrow.vector.VarBinaryVector;
+import org.apache.arrow.vector.VarCharVector;
+import org.apache.arrow.vector.types.DateUnit;
+import org.apache.arrow.vector.types.FloatingPointPrecision;
+import org.apache.arrow.vector.types.TimeUnit;
+import org.apache.arrow.vector.types.pojo.ArrowType;
+import org.apache.arrow.vector.types.pojo.Field;
+import org.apache.arrow.vector.types.pojo.FieldType;
+
+import java.io.IOException;
+import java.io.StringWriter;
+import java.io.UncheckedIOException;
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.nio.charset.StandardCharsets;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import java.time.LocalTime;
+import java.time.ZoneId;
+import java.time.ZoneOffset;
+import java.time.temporal.ChronoUnit;
+import java.util.Base64;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * One Trino result column as an Arrow field, and how a value of it, as the Trino client protocol
+ * hands it on ({@code io.trino.client.FixJsonDataUtils}), is written into the field's vector.
+ *
+ * <p>Every field carries three metadata entries:
+ *
+ * <ul>
+ *   <li>{@value #TYPE_KEY}: the column's Trino type as the coordinator names it (the protocol's
+ *       {@code type}, e.g. {@code timestamp(6) with time zone});
+ *   <li>{@value #SIGNATURE_KEY}: the column's type signature, as JSON in the protocol's own form;
+ *   <li>{@value #ENCODING_KEY}: how the field holds a value: {@code arrow} (the Arrow type is the
+ *       value), {@code text} (Utf8, the protocol's text of a scalar Trino has no Arrow type for:
+ *       time with time zone, the intervals, json, uuid, ipaddress) or {@code json} (Utf8, the
+ *       protocol's JSON of the value: array, map, row and any other type).
+ * </ul>
+ *
+ * <p>Temporal values are microseconds. A value with more fractional digits than six is rounded to
+ * six half-to-even, the rounding the Trino Python client applies, so both readers give the same
+ * value.
+ */
+final class TrinoArrowColumn {
+  static final String TYPE_KEY = "trino.type";
+  static final String SIGNATURE_KEY = "trino.type_signature";
+  static final String ENCODING_KEY = "trino.encoding";
+
+  static final String ENCODING_ARROW = "arrow";
+  static final String ENCODING_TEXT = "text";
+  static final String ENCODING_JSON = "json";
+
+  private static final long MICROS_PER_DAY = 86_400_000_000L;
+
+  /** Scalars the protocol sends as text and Arrow has no type for: sent as that text. */
+  private static final Set<String> TEXT_TYPES =
+      Set.of(
+          "time with time zone",
+          "interval year to month",
+          "interval day to second",
+          "json",
+          "uuid",
+          "ipaddress");
+
+  /** The coordinator's own JSON settings for a type signature (airlift's ObjectMapperProvider). */
+  private static final ObjectMapper SIGNATURE_MAPPER =
+      JsonMapper.builder()
+          .disable(MapperFeature.AUTO_DETECT_CREATORS)
+          .disable(MapperFeature.AUTO_DETECT_FIELDS)
+          .disable(MapperFeature.AUTO_DETECT_SETTERS)
+          .disable(MapperFeature.AUTO_DETECT_GETTERS)
+          .disable(MapperFeature.AUTO_DETECT_IS_GETTERS)
+          .serializationInclusion(JsonInclude.Include.NON_ABSENT)
+          .addModule(new Jdk8Module())
+          .build();
+
+  private static final JsonFactory JSON = new JsonFactory();
+
+  /** Writes one non-null value into a vector at a row. */
+  interface Writer {
+    void write(FieldVector vector, int row, Object value);
+  }
+
+  private final Field field;
+  private final Writer writer;
+
+  private TrinoArrowColumn(Field field, Writer writer) {
+    this.field = field;
+    this.writer = writer;
+  }
+
+  Field field() {
+    return field;
+  }
+
+  /** Writes {@code value} (null included) into {@code vector} at {@code row}. */
+  void write(FieldVector vector, int row, Object value) {
+    if (value == null) {
+      if (vector instanceof BaseFixedWidthVector fixed) {
+        fixed.setNull(row);
+      } else if (vector instanceof BaseVariableWidthVector variable) {
+        variable.setNull(row);
+      }
+      // A NullVector holds nulls only: its value count is set with the batch's row count.
+      return;
+    }
+    writer.write(vector, row, value);
+  }
+
+  static TrinoArrowColumn of(Column column) {
+    ClientTypeSignature signature = column.getTypeSignature();
+    String rawType = signature.getRawType();
+    ArrowType arrowType;
+    Writer writer;
+    String encoding = ENCODING_ARROW;
+    switch (rawType) {
+      case "boolean" -> {
+        arrowType = ArrowType.Bool.INSTANCE;
+        writer = (v, r, x) -> ((BitVector) v).setSafe(r, ((Boolean) x) ? 1 : 0);
+      }
+      case "tinyint" -> {
+        arrowType = new ArrowType.Int(8, true);
+        writer = (v, r, x) -> ((TinyIntVector) v).setSafe(r, ((Number) x).byteValue());
+      }
+      case "smallint" -> {
+        arrowType = new ArrowType.Int(16, true);
+        writer = (v, r, x) -> ((SmallIntVector) v).setSafe(r, ((Number) x).shortValue());
+      }
+      case "integer" -> {
+        arrowType = new ArrowType.Int(32, true);
+        writer = (v, r, x) -> ((IntVector) v).setSafe(r, ((Number) x).intValue());
+      }
+      case "bigint" -> {
+        arrowType = new ArrowType.Int(64, true);
+        writer = (v, r, x) -> ((BigIntVector) v).setSafe(r, ((Number) x).longValue());
+      }
+      case "real" -> {
+        arrowType = new ArrowType.FloatingPoint(FloatingPointPrecision.SINGLE);
+        writer = (v, r, x) -> ((Float4Vector) v).setSafe(r, ((Number) x).floatValue());
+      }
+      case "double" -> {
+        arrowType = new ArrowType.FloatingPoint(FloatingPointPrecision.DOUBLE);
+        writer = (v, r, x) -> ((Float8Vector) v).setSafe(r, ((Number) x).doubleValue());
+      }
+      case "decimal" -> {
+        int precision = (int) longArgument(signature, 0);
+        int scale = (int) longArgument(signature, 1);
+        arrowType = new ArrowType.Decimal(precision, scale, 128);
+        writer = (v, r, x) -> ((DecimalVector) v).setSafe(r, new BigDecimal((String) x));
+      }
+      case "varchar", "char" -> {
+        arrowType = ArrowType.Utf8.INSTANCE;
+        writer = (v, r, x) -> ((VarCharVector) v).setSafe(r, utf8((String) x));
+      }
+      case "varbinary" -> {
+        arrowType = ArrowType.Binary.INSTANCE;
+        writer = (v, r, x) -> ((VarBinaryVector) v).setSafe(r, (byte[]) x);
+      }
+      case "date" -> {
+        arrowType = new ArrowType.Date(DateUnit.DAY);
+        writer = (v, r, x) -> ((DateDayVector) v).setSafe(r, dateDays((String) x));
+      }
+      case "time" -> {
+        arrowType = new ArrowType.Time(TimeUnit.MICROSECOND, 64);
+        writer = (v, r, x) -> ((TimeMicroVector) v).setSafe(r, timeMicros((String) x));
+      }
+      case "timestamp" -> {
+        arrowType = new ArrowType.Timestamp(TimeUnit.MICROSECOND, null);
+        writer = (v, r, x) -> ((TimeStampMicroVector) v).setSafe(r, timestampMicros((String) x));
+      }
+      case "timestamp with time zone" -> {
+        arrowType = new ArrowType.Timestamp(TimeUnit.MICROSECOND, "UTC");
+        writer =
+            (v, r, x) -> ((TimeStampMicroTZVector) v).setSafe(r, zonedTimestampMicros((String) x));
+      }
+      case "unknown" -> {
+        // The type of a bare NULL: every value is null.
+        arrowType = ArrowType.Null.INSTANCE;
+        writer =
+            (v, r, x) -> {
+              throw new IllegalStateException("a value of type unknown that is not null: " + x);
+            };
+      }
+      default -> {
+        arrowType = ArrowType.Utf8.INSTANCE;
+        if (TEXT_TYPES.contains(rawType)) {
+          encoding = ENCODING_TEXT;
+          writer = (v, r, x) -> ((VarCharVector) v).setSafe(r, utf8((String) x));
+        } else {
+          encoding = ENCODING_JSON;
+          writer = (v, r, x) -> ((VarCharVector) v).setSafe(r, utf8(protocolJson(x)));
+        }
+      }
+    }
+    Map<String, String> metadata =
+        Map.of(
+            TYPE_KEY, column.getType(),
+            SIGNATURE_KEY, signatureJson(signature),
+            ENCODING_KEY, encoding);
+    Field field = new Field(column.getName(), new FieldType(true, arrowType, null, metadata), null);
+    return new TrinoArrowColumn(field, writer);
+  }
+
+  private static long longArgument(ClientTypeSignature signature, int index) {
+    ClientTypeSignatureParameter argument = signature.getArguments().get(index);
+    return argument.getLongLiteral();
+  }
+
+  private static byte[] utf8(String text) {
+    return text.getBytes(StandardCharsets.UTF_8);
+  }
+
+  static String signatureJson(ClientTypeSignature signature) {
+    try {
+      return SIGNATURE_MAPPER.writeValueAsString(signature);
+    } catch (JsonProcessingException e) {
+      throw new UncheckedIOException(e);
+    }
+  }
+
+  /** {@code yyyy-MM-dd} as days since the epoch (proleptic Gregorian, as the protocol's text). */
+  static int dateDays(String value) {
+    return Math.toIntExact(LocalDate.parse(value).toEpochDay());
+  }
+
+  /** The fraction digits after the seconds' point as microseconds, rounded half-to-even. */
+  static long fractionMicros(String digits) {
+    if (digits.isEmpty()) {
+      return 0;
+    }
+    return new BigDecimal("0." + digits)
+        .setScale(6, RoundingMode.HALF_EVEN)
+        .movePointRight(6)
+        .longValueExact();
+  }
+
+  /** {@code HH:mm:ss[.f...]} as microseconds since midnight; a fraction that rounds up to the next
+   * second at 23:59:59 wraps to midnight, as a Python {@code time} does. */
+  static long timeMicros(String value) {
+    long micros = LocalTime.parse(value.substring(0, 8)).toNanoOfDay() / 1000;
+    String digits = value.length() > 9 ? value.substring(9) : "";
+    return Math.floorMod(micros + fractionMicros(digits), MICROS_PER_DAY);
+  }
+
+  /** {@code yyyy-MM-dd HH:mm:ss[.f...]} (a local date-time) as microseconds since the epoch read
+   * as UTC: the wall-clock value, no zone applied. */
+  static long timestampMicros(String value) {
+    return epochMicros(localDateTime(value).toInstant(ZoneOffset.UTC));
+  }
+
+  /** {@code yyyy-MM-dd HH:mm:ss[.f...] <zone>} (an offset {@code +05:30} or a region) as the
+   * instant it names, in microseconds since the epoch. */
+  static long zonedTimestampMicros(String value) {
+    int space = value.lastIndexOf(' ');
+    String zone = value.substring(space + 1);
+    ZoneId zoneId =
+        zone.startsWith("+") || zone.startsWith("-") ? ZoneOffset.of(zone) : ZoneId.of(zone);
+    return epochMicros(localDateTime(value.substring(0, space)).atZone(zoneId).toInstant());
+  }
+
+  private static LocalDateTime localDateTime(String value) {
+    LocalDateTime whole = LocalDateTime.parse(value.substring(0, 10) + "T" + value.substring(11, 19));
+    String digits = value.length() > 20 ? value.substring(20) : "";
+    return whole.plus(fractionMicros(digits), ChronoUnit.MICROS);
+  }
+
+  private static long epochMicros(Instant instant) {
+    return Math.addExact(
+        Math.multiplyExact(instant.getEpochSecond(), 1_000_000L), instant.getNano() / 1000);
+  }
+
+  /** A value as the protocol's JSON writes it: the inverse of {@code FixJsonDataUtils}. */
+  static String protocolJson(Object value) {
+    StringWriter out = new StringWriter();
+    try (JsonGenerator generator = JSON.createGenerator(out)) {
+      writeJson(generator, value);
+    } catch (IOException e) {
+      throw new UncheckedIOException(e);
+    }
+    return out.toString();
+  }
+
+  private static void writeJson(JsonGenerator generator, Object value) throws IOException {
+    if (value == null) {
+      generator.writeNull();
+    } else if (value instanceof Boolean b) {
+      generator.writeBoolean(b);
+    } else if (value instanceof Double d) {
+      if (d.isNaN() || d.isInfinite()) {
+        generator.writeString(d.toString());
+      } else {
+        generator.writeNumber(d);
+      }
+    } else if (value instanceof Float f) {
+      if (f.isNaN() || f.isInfinite()) {
+        generator.writeString(f.toString());
+      } else {
+        generator.writeNumber(f);
+      }
+    } else if (value instanceof Long l) {
+      generator.writeNumber(l);
+    } else if (value instanceof Integer i) {
+      generator.writeNumber(i);
+    } else if (value instanceof Short s) {
+      generator.writeNumber(s);
+    } else if (value instanceof Byte b) {
+      generator.writeNumber(b);
+    } else if (value instanceof byte[] bytes) {
+      generator.writeString(Base64.getEncoder().encodeToString(bytes));
+    } else if (value instanceof List<?> list) {
+      generator.writeStartArray();
+      for (Object element : list) {
+        writeJson(generator, element);
+      }
+      generator.writeEndArray();
+    } else if (value instanceof Map<?, ?> map) {
+      generator.writeStartObject();
+      for (Map.Entry<?, ?> entry : map.entrySet()) {
+        generator.writeFieldName(mapKey(entry.getKey()));
+        writeJson(generator, entry.getValue());
+      }
+      generator.writeEndObject();
+    } else if (value instanceof Row row) {
+      generator.writeStartArray();
+      for (RowField rowField : row.getFields()) {
+        writeJson(generator, rowField.getValue());
+      }
+      generator.writeEndArray();
+    } else {
+      generator.writeString(value.toString());
+    }
+  }
+
+  /** A map key as the protocol's JSON object writes it: its text. */
+  private static String mapKey(Object key) {
+    if (key instanceof byte[] bytes) {
+      return Base64.getEncoder().encodeToString(bytes);
+    }
+    return String.valueOf(key);
+  }
+}
