new file mode 100644
index 0000000..bcf2f69
--- /dev/null
+++ b/src/main/java/ru/raiffeisen/trino/arrow/flight/sql/producer/TrinoQueryFailure.java
@@ -0,0 +1,71 @@
+package ru.raiffeisen.trino.arrow.flight.sql.producer;
+
+import io.trino.client.QueryError;
+import org.apache.arrow.flight.CallStatus;
+import org.apache.arrow.flight.ErrorFlightMetadata;
+import org.apache.arrow.flight.FlightRuntimeException;
+
+import java.nio.charset.StandardCharsets;
+
+/**
+ * A statement Trino failed, carried to the Flight client with Trino's own error: the status
+ * description is Trino's message, and the trailers name the error as the Trino protocol does
+ * ({@value #ERROR_NAME}, {@value #ERROR_TYPE}, {@value #ERROR_CODE}, {@value #QUERY_ID}), and
+ * {@value #ERROR_MESSAGE} holds Trino's message byte for byte (a status description is not: the
+ * client library wraps it).
+ *
+ * <p>A failure to reach the coordinator at all is {@link CallStatus#UNAVAILABLE} with
+ * {@value #ERROR_KIND} {@code connection} and no Trino error name: no statement ran.
+ */
+final class TrinoQueryFailure extends Exception {
+  static final String ERROR_NAME = "x-trino-error-name";
+  static final String ERROR_TYPE = "x-trino-error-type";
+  static final String ERROR_CODE = "x-trino-error-code";
+  static final String QUERY_ID = "x-trino-query-id";
+  static final String ERROR_KIND = "x-trino-error-kind";
+  static final String ERROR_MESSAGE = "x-trino-error-message-bin";
+
+  private final transient FlightRuntimeException flightError;
+
+  private TrinoQueryFailure(String message, FlightRuntimeException flightError, Throwable cause) {
+    super(message, cause);
+    this.flightError = flightError;
+  }
+
+  /** The statement {@code queryId} failed with {@code error}. */
+  static TrinoQueryFailure of(String queryId, QueryError error) {
+    ErrorFlightMetadata metadata = new ErrorFlightMetadata();
+    metadata.insert(ERROR_KIND, "query");
+    metadata.insert(ERROR_NAME, error.getErrorName());
+    metadata.insert(ERROR_TYPE, error.getErrorType());
+    metadata.insert(ERROR_CODE, Integer.toString(error.getErrorCode()));
+    metadata.insert(QUERY_ID, queryId);
+    metadata.insert(ERROR_MESSAGE, error.getMessage().getBytes(StandardCharsets.UTF_8));
+    CallStatus status =
+        statusOf(error.getErrorType()).withDescription(error.getMessage()).withMetadata(metadata);
+    return new TrinoQueryFailure(error.getMessage(), status.toRuntimeException(), null);
+  }
+
+  /** The coordinator could not be reached, or stopped answering the statement's protocol. */
+  static TrinoQueryFailure unreachable(RuntimeException cause) {
+    ErrorFlightMetadata metadata = new ErrorFlightMetadata();
+    metadata.insert(ERROR_KIND, "connection");
+    String message = String.valueOf(cause.getMessage());
+    metadata.insert(ERROR_MESSAGE, message.getBytes(StandardCharsets.UTF_8));
+    CallStatus status =
+        CallStatus.UNAVAILABLE.withDescription(message).withCause(cause).withMetadata(metadata);
+    return new TrinoQueryFailure(message, status.toRuntimeException(), cause);
+  }
+
+  FlightRuntimeException toFlightError() {
+    return flightError;
+  }
+
+  private static CallStatus statusOf(String errorType) {
+    return switch (errorType) {
+      case "USER_ERROR" -> CallStatus.INVALID_ARGUMENT;
+      case "INSUFFICIENT_RESOURCES" -> CallStatus.RESOURCE_EXHAUSTED;
+      default -> CallStatus.INTERNAL;
+    };
+  }
+}
