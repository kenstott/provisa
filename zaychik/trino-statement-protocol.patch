@@ -0,0 +1,71 @@
+package ru.raiffeisen.trino.arrow.flight.sql.connection;
+
+import io.airlift.units.Duration;
+import io.trino.client.ClientSession;
+import io.trino.client.OkHttpUtil;
+import io.trino.client.StatementClient;
+import io.trino.client.StatementClientFactory;
+import okhttp3.OkHttpClient;
+import ru.raiffeisen.trino.arrow.flight.sql.config.TrinoConfiguration;
+
+import java.net.URI;
+import java.time.ZoneId;
+import java.util.Locale;
+import java.util.Optional;
+import java.util.Set;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Submits statements to Trino through its client protocol (the protocol the Trino JDBC driver and
+ * the Trino Python client speak), so a statement's result arrives with what JDBC drops: each
+ * column's type as the coordinator names it and its full type signature, each value as the
+ * protocol carries it, and a failure's error name, type and code.
+ */
+public final class TrinoStatementClients {
+  /** The capabilities the Trino Python client declares, so values and type names match it. */
+  private static final Set<String> CLIENT_CAPABILITIES =
+      Set.of("PARAMETRIC_DATETIME", "SESSION_AUTHORIZATION");
+
+  /**
+   * The source of a statement whose client names none: the Trino JDBC driver's, which this proxy
+   * sent before it spoke the client protocol, so a coordinator's resource-group selectors that
+   * place the proxy's statements still do.
+   */
+  private static final String DEFAULT_SOURCE = "trino-jdbc";
+
+  private final URI server;
+  private final boolean ssl;
+  private final OkHttpClient httpClient;
+
+  public TrinoStatementClients(TrinoConfiguration config) {
+    this.ssl = config.TRINO_SSL;
+    this.server = URI.create((ssl ? "https" : "http") + "://" + config.TRINO_HOST + ":" + config.TRINO_PORT);
+    OkHttpClient.Builder builder = new OkHttpClient.Builder();
+    OkHttpUtil.setupTimeouts(builder, 60, TimeUnit.SECONDS);
+    this.httpClient = builder.build();
+  }
+
+  /** Submits {@code sql} for {@code user} in {@code context}'s session. */
+  public StatementClient submit(
+      String user, String password, TrinoStatementContext context, String sql) {
+    ClientSession session =
+        ClientSession.builder()
+            .server(server)
+            .user(Optional.of(user))
+            .source(context.source().orElse(DEFAULT_SOURCE))
+            .catalog(context.catalog().orElse(null))
+            .schema(context.schema().orElse(null))
+            .properties(context.properties())
+            .timeZone(ZoneId.systemDefault())
+            .locale(Locale.getDefault())
+            .clientRequestTimeout(new Duration(60, TimeUnit.SECONDS))
+            .build();
+    OkHttpClient client = httpClient;
+    if (ssl && !password.isEmpty()) {
+      // A password is sent only over TLS, as the Trino clients require.
+      client = httpClient.newBuilder().addInterceptor(OkHttpUtil.basicAuth(user, password)).build();
+    }
+    return StatementClientFactory.newStatementClient(
+        client, session, sql, Optional.of(CLIENT_CAPABILITIES));
+  }
+}
diff --git a/src/main/java/ru/raiffeisen/trino/arrow/flight/sql/connection/TrinoStatementContext.java b/src/main/java/ru/raiffeisen/trino/arrow/flight/sql/connection/TrinoStatementContext.java
