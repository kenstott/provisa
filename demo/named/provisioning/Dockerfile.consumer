FROM python:3.12-slim
RUN pip install --no-cache-dir aiokafka==0.14.0 pyarrow==24.0.0 "psycopg[binary]==3.3.4"
WORKDIR /app
COPY consumer.py ./
ENTRYPOINT ["python", "consumer.py"]
