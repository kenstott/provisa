# The streaming demo's live order feed (producer.py), the `producer` service of both compose files.
FROM python:3.12-slim
RUN pip install --no-cache-dir aiokafka==0.14.0
WORKDIR /app
COPY producer.py ./
ENTRYPOINT ["python", "producer.py"]
