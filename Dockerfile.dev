# syntax=docker/dockerfile:1
# Dev/test image — installs from PyPI (no pre-built wheels required)
FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml .
# Every package at the version uv.lock pins, as Dockerfile installs them: pip resolving the
# pyproject's ranges against PyPI's newest takes as long as its backtracking does (the cluster
# lane's 600 s build bound ran out on it) and ships versions no test ran on.
COPY uv.lock .
# REQ-2071: provisa-notebook, a dependency built from this repository (Dockerfile does the same).
COPY provisa-notebook/ ./provisa-notebook/
COPY provisa-client/ ./provisa-client/
COPY --from=ghcr.io/astral-sh/uv:0.11.19 /uv /usr/local/bin/uv
RUN uv export --frozen --no-dev --no-emit-project --no-hashes --no-annotate --no-header \
      -o /tmp/locked.txt \
 && grep -v '^-e ' /tmp/locked.txt > /tmp/requirements.txt \
 && pip install --no-cache-dir --no-deps -r /tmp/requirements.txt \
 && PYTHONPATH=provisa-notebook python -m provisa_notebook.build > /dev/null \
 && pip install --no-cache-dir --no-deps ./provisa-notebook \
 && pip install --no-cache-dir --no-deps . \
 && rm -rf /usr/local/bin/uv /tmp/locked.txt /tmp/requirements.txt provisa-notebook provisa-client
COPY main.py pyproject.toml ./
COPY provisa/ ./provisa/
COPY static/ ./static/
RUN mkdir -p ./config && useradd -m -u 1000 appuser && chown -R appuser /app
USER 1000

EXPOSE 8000 3000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
