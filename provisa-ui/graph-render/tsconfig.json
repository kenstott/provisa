{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "react"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "typeRoots": ["./node_modules/@types", "../node_modules/@types"]
  },
  "include": ["src", "../src/components/provisa-graph/types/cytoscape*.d.ts"]
}
