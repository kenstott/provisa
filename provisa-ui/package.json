{
  "name": "provisa-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.12.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "vite",
    "screenshots": "npx tsx scripts/capture-screenshots.ts",
    "prebuild": "node scripts/build-docs-site.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "preview": "vite preview",
    "test:unit": "vitest run --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:core": "PROVISA_E2E_LANE=core npx playwright test --project=core; core=$?; PROVISA_E2E_LANE=core npx playwright test --project=core-provisioning --workers=1 && exit $core",
    "test:e2e:trino": "PROVISA_E2E_LANE=trino npx playwright test --project=trino",
    "coverage:clean": "rm -rf .nyc_output .nyc_output_flat coverage",
    "coverage:merge": "mkdir -p .nyc_output_flat && cp .nyc_output/vitest/coverage-final.json .nyc_output_flat/vitest.json && cp .nyc_output/playwright/*.json .nyc_output_flat/ && nyc merge .nyc_output_flat coverage/merged.json",
    "coverage:report": "mkdir -p coverage/.nyc_output && cp coverage/merged.json coverage/.nyc_output/coverage-final.json && nyc report --temp-dir coverage/.nyc_output --reporter text --reporter html --report-dir coverage/html",
    "coverage": "npm run coverage:clean && npm run test:unit && npm run test:e2e && npm run coverage:merge && npm run coverage:report"
  },
  "dependencies": {
    "@apollo/client": "^4.2.2",
    "@chatscope/chat-ui-kit-react": "^2.1.1",
    "@chatscope/chat-ui-kit-styles": "^1.4.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@firebase/app": "^0.16.7",
    "@firebase/auth": "^1.13.11",
    "@graphiql/plugin-explorer": "^5.1.5",
    "@graphiql/toolkit": "^0.12.0",
    "@mantine/core": "^8.1.0",
    "@mantine/dates": "^8.3.18",
    "@mantine/hooks": "^8.1.0",
    "@mantine/notifications": "^8.1.0",
    "@neo4j-cypher/codemirror": "^1.0.3",
    "@uiw/react-codemirror": "^4.25.10",
    "cm6-graphql": "^0.2.1",
    "cytoscape": "^3.33.4",
    "cytoscape-fcose": "^2.2.0",
    "cytoscape-layout-utilities": "^1.1.1",
    "cytoscape-svg": "^0.4.0",
    "driver.js": "^1.6.0",
    "elkjs": "^0.9.3",
    "esbuild": "^0.28.2",
    "graphiql": "^5.4.0",
    "graphql": "^16.14.0",
    "graphql-voyager": "^2.1.0",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "idb-keyval": "^6.2.4",
    "lucide-react": "^1.17.0",
    "mermaid": "^12.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.1",
    "rolldown": "^1.0.3",
    "rrule": "^2.8.1",
    "simple-icons": "^16.34.0",
    "sql-formatter": "^15.8.0",
    "three": "0.170.0",
    "vite-plugin-monaco-editor": "^1.1.0",
    "write-excel-file": "^4.1.1"
  },
  "scarfSettings": {
    "enabled": false
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@graphql-tools/graphql-file-loader": "^9.1.2",
    "@playwright/test": "^1.61.1",
    "@rollup/plugin-graphql": "^3.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.170.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "js-yaml": "4.3.2",
    "jsdom": "^29.1.1",
    "nyc": "^18.0.0",
    "postcss": "^8.5.33",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.8.3",
    "swagger-ui-dist": "5.34.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^4.1.12",
    "ws": "^8.23.0"
  }
}
