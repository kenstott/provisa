# Runs the demo stores sync as soon as the sandbox tier asks for a demo, or sees a newer version
# published: the tier touches <bundles>/.wanted after writing <bundles>/<name>/requested
# (REQ-2049), in the host's view of the tier's data directory (first-launch.sh mounts
# /root/.provisa/sandbox-data there).
[Unit]
Description=Provisa sandbox tier: a demo version was asked for

[Path]
PathChanged=/root/.provisa/sandbox-data/demo-bundles/.wanted
Unit=provisa-demo-stores.service

[Install]
WantedBy=multi-user.target
