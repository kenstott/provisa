# The demo stores sync at boot and every quarter hour: a demo published since is pulled, and its
# stores brought up once a visitor's open has asked for the demo (REQ-2049).
[Unit]
Description=Provisa sandbox tier: demo stores sync, at boot and periodically

[Timer]
OnBootSec=2min
OnUnitActiveSec=15min
Unit=provisa-demo-stores.service

[Install]
WantedBy=timers.target
