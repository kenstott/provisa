<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- No app sandbox — the launcher runs first-launch.sh and the provisa CLI, which need
       full filesystem access (~/.provisa, /usr/local/bin) and the user's Docker socket. -->
  <key>com.apple.security.app-sandbox</key>
  <false/>
</dict>
</plist>
