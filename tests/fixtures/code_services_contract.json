{
  "_doc": "REQ-2106: what provisa_services (Python) and @provisa/services (Node) each send to $PROVISA_SERVICES for one call, and what they return for an answer. Each case: the call in each language (py, js), the request it must send (method, path after the token, JSON body or null), the answer given (status, content type, body), and the result (the value the call returns, or the error it raises: its service and status).",
  "cases": [
    {"name": "a secret, as text",
     "py": "ps.secrets.get('openrouter')", "js": "s.secrets.get('openrouter')",
     "request": {"method": "GET", "path": "secrets/openrouter", "body": null},
     "answer": {"status": 200, "type": "text/plain", "body": "sk-test"},
     "returns": "sk-test"},
    {"name": "a setting",
     "py": "ps.settings.get('region')", "js": "s.settings.get('region')",
     "request": {"method": "GET", "path": "settings/region", "body": null},
     "answer": {"status": 200, "type": "application/json", "body": {"value": "eu-west"}},
     "returns": "eu-west"},
    {"name": "a setting not declared, with a fallback",
     "py": "ps.settings.get('nope', 'dflt')", "js": "s.settings.get('nope', 'dflt')",
     "request": {"method": "GET", "path": "settings/nope", "body": null},
     "answer": {"status": 404, "type": "application/json", "body": {"error": {"message": "no setting 'nope'", "code": 404}}},
     "returns": "dflt"},
    {"name": "a cache miss",
     "py": "ps.cache.get('rates')", "js": "s.cache.get('rates')",
     "request": {"method": "GET", "path": "cache/rates", "body": null},
     "answer": {"status": 404, "type": "application/json", "body": {"error": {"message": "the cache holds no 'rates'", "code": 404}}},
     "returns": null},
    {"name": "a cache set with a ttl",
     "py": "ps.cache.set('rates', {'usd': 1.0}, ttl=60)", "js": "s.cache.set('rates', {usd: 1.0}, 60)",
     "request": {"method": "PUT", "path": "cache/rates", "body": {"value": {"usd": 1.0}, "ttl": 60}},
     "answer": {"status": 200, "type": "application/json", "body": {}},
     "returns": null},
    {"name": "a vector search",
     "py": "ps.vectors.search('late payment', k=2, model='m')", "js": "s.vectors.search('late payment', 2, 'm')",
     "request": {"method": "POST", "path": "vectors/search", "body": {"query": "late payment", "k": 2, "model": "m"}},
     "answer": {"status": 200, "type": "application/json", "body": {"matches": [{"id": "a", "score": 0.9, "text": "late", "metadata": {}}]}},
     "returns": [{"id": "a", "score": 0.9, "text": "late", "metadata": {}}]},
    {"name": "a fetch through Provisa",
     "py": "ps.http.get('https://api.example.com/r').text", "js": "(await s.http.get('https://api.example.com/r')).text()",
     "request": {"method": "POST", "path": "http", "body": {"method": "GET", "url": "https://api.example.com/r", "headers": {}, "timeout": null}},
     "answer": {"status": 200, "type": "application/json", "body": {"status": 200, "headers": {}, "body": "hello"}},
     "returns": "hello"},
    {"name": "a chat completion",
     "py": "ps.llm.chat('provisa:sql_generation', [{'role': 'user', 'content': 'q'}])['choices'][0]['message']['content']",
     "js": "(await s.llm.chat('provisa:sql_generation', [{role: 'user', content: 'q'}])).choices[0].message.content",
     "request": {"method": "POST", "path": "llm/v1/chat/completions", "body": {"model": "provisa:sql_generation", "messages": [{"role": "user", "content": "q"}]}},
     "answer": {"status": 200, "type": "application/json", "body": {"choices": [{"message": {"role": "assistant", "content": "a"}}]}},
     "returns": "a"},
    {"name": "a log line",
     "py": "ps.log('scored', level='warning', accounts=3)", "js": "s.log('scored', 'warning', {accounts: 3})",
     "request": {"method": "POST", "path": "log", "body": {"level": "warning", "message": "scored", "fields": {"accounts": 3}}},
     "answer": {"status": 200, "type": "application/json", "body": {}},
     "returns": null},
    {"name": "a metric point",
     "py": "ps.metric('scored', 3, kind='gauge', region='eu')", "js": "s.metric('scored', 3, 'gauge', {region: 'eu'})",
     "request": {"method": "POST", "path": "metric", "body": {"name": "scored", "value": 3, "kind": "gauge", "attributes": {"region": "eu"}}},
     "answer": {"status": 200, "type": "application/json", "body": {}},
     "returns": null},
    {"name": "a refusal raised, naming the service",
     "py": "ps.vectors.embed(['x'], 'nope')", "js": "s.vectors.embed(['x'], 'nope')",
     "request": {"method": "POST", "path": "vectors/embed", "body": {"texts": ["x"], "model": "nope"}},
     "answer": {"status": 403, "type": "application/json", "body": {"error": {"message": "the model 'nope' is not one of the org's vector models", "code": 403}}},
     "raises": {"service": "vectors", "status": 403, "message": "the model 'nope' is not one of the org's vector models"}}
  ]
}
