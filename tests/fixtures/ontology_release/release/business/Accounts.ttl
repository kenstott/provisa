@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix fnd: <https://example.org/mini-fibo/foundations/Parties/> .
@prefix agr: <https://example.org/mini-fibo/foundations/Agreements/> .
@prefix acc: <https://example.org/mini-fibo/business/Accounts/> .

<https://example.org/mini-fibo/business/Accounts/> a owl:Ontology ;
    rdfs:label "Accounts" ;
    owl:imports <https://example.org/mini-fibo/2026Q4/foundations/Parties/> ,
        <https://example.org/mini-fibo/foundations/Agreements/> ,
        <https://www.omg.org/spec/Commons/Classifiers/> .

acc:Account a owl:Class ;
    rdfs:subClassOf agr:Agreement ,
        [ a owl:Restriction ; owl:onProperty acc:isHeldBy ; owl:someValuesFrom fnd:Party ] ,
        [ a owl:Restriction ; owl:onProperty acc:hasAccountNumber ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onDataRange xsd:string ] ;
    rdfs:label "account"@en , "compte"@fr ;
    skos:definition "A record of the holdings of a party with a provider."@en .

acc:AccountStatus a owl:Class ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( acc:Open acc:Closed ) ] ;
    rdfs:label "account status"@en ;
    skos:definition "Whether an account can be used."@en .

acc:Open a owl:NamedIndividual , acc:AccountStatus ;
    rdfs:label "open"@en ;
    skos:definition "The account can be used."@en .

acc:Closed a owl:NamedIndividual , acc:AccountStatus ;
    rdfs:label "closed"@en .

acc:FlagshipBank a owl:NamedIndividual , fnd:Organization ;
    rdfs:label "Flagship Bank"@en ;
    fnd:hasLegalName "Flagship Bank, N.A." ;
    fnd:isControlledBy acc:FlagshipHoldings .

acc:isHeldBy a owl:ObjectProperty ;
    rdfs:label "is held by"@en ;
    rdfs:domain acc:Account ;
    rdfs:range fnd:Party ;
    owl:inverseOf acc:holds .

acc:holds a owl:ObjectProperty ;
    rdfs:label "holds"@en .

acc:hasUltimateController a owl:ObjectProperty ;
    rdfs:label "has ultimate controller"@en ;
    owl:propertyChainAxiom ( acc:isHeldBy fnd:isControlledBy ) .

acc:hasAccountNumber a owl:DatatypeProperty ;
    rdfs:label "has account number"@en ;
    rdfs:domain acc:Account ;
    rdfs:range xsd:string .

acc:hasBalance a owl:DatatypeProperty ;
    rdfs:label "has balance"@en ;
    rdfs:domain acc:Account ;
    rdfs:range [ a rdfs:Datatype ; owl:onDatatype xsd:decimal ;
                 owl:withRestrictions ( [ xsd:minInclusive "0"^^xsd:decimal ] ) ] .
