.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.git/
.idea/
.vscode/
# Every node_modules, at any depth: each stage that needs one runs its own `npm ci`
**/node_modules/
packaging/
*.egg-info/
dist/
build/
*.log
.DS_Store
._*
__MACOSX/
.env
# render_graph renderer: a checkout links it to provisa-ui/graph-render; the image builds its own
provisa/_graph_render
# The encoders' local cargo and bench output, and the module an editable install compiles into the
# checkout: the image compiles provisa._encoders itself, for its own platform (REQ-2194)
rust/pgwire/target/
rust/encoders/target/
rust/encoders/json/target/
provisa/_encoders*.so
provisa/_encoders*.pyd
# The ui-build stage builds the UI from provisa-ui's sources and lockfile; a checkout's own build
# output, its generated offline docs site and its test output stay out of the context
provisa-ui/dist/
provisa-ui/public/docs-site/
provisa-ui/coverage/
provisa-ui/test-results/
provisa-ui/playwright-report/
provisa-ui/.nyc_output/
provisa-ui/.nyc_output_flat/
