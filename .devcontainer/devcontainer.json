{
  "name": "Provisa",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "mounts": [
    "source=provisa-venv-${devcontainerId},target=${containerWorkspaceFolder}/.venv,type=volume",
    "source=provisa-node-modules-${devcontainerId},target=${containerWorkspaceFolder}/provisa-ui/node_modules,type=volume",
    "source=provisa-encoders-target-${devcontainerId},target=${containerWorkspaceFolder}/rust/encoders/target,type=volume"
  ],
  "forwardPorts": [3000, 8001],
  "portsAttributes": {
    "3000": {
      "label": "Provisa UI",
      "onAutoForward": "openBrowser"
    },
    "8001": {
      "label": "Provisa API",
      "onAutoForward": "silent"
    }
  },
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/rust:1.6.0": {
      "version": "1.95.0",
      "profile": "minimal"
    },
    "ghcr.io/devcontainers/features/go:1.4.1": {
      "version": "1.27.3"
    },
    "ghcr.io/devcontainers/features/node:2.1.1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {
      "moby": false
    }
  },
  "containerEnv": {
    "UV_PROJECT_ENVIRONMENT": "${containerWorkspaceFolder}/.venv",
    "UV_PYTHON": "/usr/local/bin/python3.12",
    "UV_PYTHON_DOWNLOADS": "never",
    "UV_LINK_MODE": "copy"
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}"
  },
  "updateContentCommand": "bash .devcontainer/update-content.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "rust-lang.rust-analyzer",
        "golang.go",
        "vitest.explorer"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests/unit"]
      }
    }
  }
}
