{
  "name": "Provisa",
  "dockerComposeFile": "compose.yml",
  "service": "dev",
  "runServices": ["dev", "postgres"],
  "workspaceFolder": "/workspaces/provisa",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/rust:1.6.0": {
      "version": "1.95.0",
      "profile": "minimal"
    },
    "ghcr.io/devcontainers/features/go:1.4.1": {
      "version": "1.27.3"
    },
    "ghcr.io/devcontainers/features/node:2.1.1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {
      "moby": false
    }
  },
  "containerEnv": {
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv",
    "UV_PYTHON": "/usr/local/bin/python3.12",
    "UV_PYTHON_DOWNLOADS": "never",
    "UV_LINK_MODE": "copy"
  },
  "remoteEnv": {
    "PATH": "/home/vscode/.venv/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "rust-lang.rust-analyzer",
        "golang.go",
        "vitest.explorer"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests/unit"]
      }
    }
  }
}
